# =============================================================================
# Grok for Mac - .gitignore
# =============================================================================
# This file ensures sensitive files are never committed to the public repository.
# Copyright © 2025 Brandon Charleson. All rights reserved.
# =============================================================================

# =============================================================================
# PROPRIETARY / SENSITIVE FILES - NEVER COMMIT
# =============================================================================

# Sparkle Auto-Update Infrastructure (PRIVATE)
# Tools + feed live outside this public repo (or stay local-only).
# SUPublicEDKey in Info.plist is the PUBLIC half — safe to commit.
# The private EdDSA key must NEVER appear in this repository.
GrokChat/bin/
GrokChat/appcast.xml
GrokChat/release.sh
GrokChat/deploy-notarized.sh
GrokChat/scripts/deploy-release.sh

# Sparkle Signing Keys (CRITICAL - NEVER COMMIT)
# Covers exports from generate_keys -x and any backups.
eddsa_private_key
eddsa_private_key*
**/eddsa_private_key
**/eddsa_private_key*
*eddsa_private*
**/dsa_priv.pem
**/sparkle_private_key*
*.NEW_ROTATED_BACKUP
ExportOptions*.plist
!GrokChat/Release/ExportOptions-Upload.plist

# Local / optional native deps (broken symlinks; never ship)
GrokChat/GhosttyKit.xcframework
GrokChat/Resources/ghostty
GrokChat/Resources/terminfo

# Code Signing Certificates
*.p12
*.cer
*.mobileprovision
*.provisionprofile

# =============================================================================
# macOS System Files
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# =============================================================================
# Xcode
# =============================================================================
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
*.xcworkspace/*
!*.xcworkspace/xcshareddata/
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace
.build/

# =============================================================================
# Swift Package Manager
# =============================================================================
.swiftpm/
Packages/
Package.pins
Package.resolved

# =============================================================================
# CocoaPods / Carthage
# =============================================================================
Pods/
Carthage/Build/

# =============================================================================
# Build Artifacts
# =============================================================================
build/
dist/
out/
*.app
*.dmg

# =============================================================================
# Environment & Secrets
# =============================================================================
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
credentials/

# =============================================================================
# IDE / Editor
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.cursor/

# =============================================================================
# Node.js (if any web components)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# =============================================================================
# Testing
# =============================================================================
/coverage
*.gcov
*.profdata

# =============================================================================
# Logs & Temporary Files
# =============================================================================
*.log
logs/
*.tmp
*.temp
.cache/